# ─── Skyhigh public configuration ────────────────────────────────
# Copy to .env (never commit .env). All VITE_* values are compiled into the
# public bundle — only put PUBLISHABLE values here. Never add service-role keys.

# Public URL of the deployed site (used for canonical URLs, sitemap, OG tags)
VITE_SITE_URL=https://<your-github-user>.github.io/skyhigh-travel
# Base path. "/" for local/custom domain, "/skyhigh-travel/" for GitHub Pages project sites
VITE_BASE=/

# Supabase (optional — enables live enquiries + admin). The anon key is public by design;
# access is enforced by Row Level Security in supabase/migrations.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional alternative to Supabase for enquiries only (e.g. a Formspree endpoint)
VITE_ENQUIRY_ENDPOINT=

# Contact details (admin panel can override these at runtime when Supabase is enabled)
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_WHATSAPP_NUMBER=
VITE_CONTACT_ADDRESS=

# Marketing (loaded only after visitor consent)
VITE_GA4_ID=
VITE_GTM_ID=
VITE_META_PIXEL_ID=
